step "hq-fail-closed-bootstrap" {
    name = "HQ fail-closed verification bootstrap"
    action {
        action_type = "Octopus.Script"
        is_required = true
        properties = {
            Octopus.Action.GitRepository.Source = "Project"
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptFileName = "scripts/octopus/verify-release-manifest.sh"
            Octopus.Action.Script.ScriptSource = "GitRepository"
            Octopus.Action.ExecutionTimeout.Minutes = "8"
        }
        worker_pool = "hosted-ubuntu"
        environments = ["Development"]
        container {
            feed = "docker-hub-public"
            image = "octopusdeploy/worker-tools:6.6.5-ubuntu.24.04"
        }
    }
}

step "hq-offline-regression" {
    name = "HQ offline regression suites"
    action {
