# Copy to /etc/ayahos/sandbox-worker.env (mode 0640, root:ayahos-sandbox).
# Never commit real values.

# Shared HMAC secret; must equal DUAL_LINEAGE_SANDBOX_WORKER_SECRET on the API.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AYAHOS_SANDBOX_SECRET=

# Image pinned by digest or local image ID; tags are refused at startup.
# After `make sandbox-image`: docker image inspect ayahos/sandbox-python:local --format '{{.Id}}'
AYAHOS_SANDBOX_IMAGE=

# Loopback only; TLS is terminated by Caddy in front (see Caddyfile.example).
AYAHOS_SANDBOX_BIND=127.0.0.1
AYAHOS_SANDBOX_PORT=8130
AYAHOS_SANDBOX_DOCKER_BIN=/usr/bin/docker
