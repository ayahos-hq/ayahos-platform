# Copy to /etc/goblin/learning-worker.env and set secrets out-of-band.
# Install the API package plus ml-requirements.txt in the worker virtualenv.
DUAL_LINEAGE_SHADOW_WORKER_SECRET=
DUAL_LINEAGE_SHADOW_ARTIFACT=/opt/goblinos-dual-lineage/models/classifiers/minilm-shadow-v1.json
DUAL_LINEAGE_MINILM_LOCAL_PATH=/opt/goblinos-dual-lineage/models/cache/sentence-transformers/all-MiniLM-L6-v2
DUAL_LINEAGE_MINILM_BACKEND=sentence-transformers
DUAL_LINEAGE_SHADOW_WORKER_HOST=127.0.0.1
DUAL_LINEAGE_SHADOW_WORKER_PORT=8120
TOKENIZERS_PARALLELISM=false
