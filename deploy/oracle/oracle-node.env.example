# Copy to /etc/goblin/oracle-node.env and set values out-of-band.
# Oracle is a cognitive-only peer by contract: the control plane (config.ORACLE_NODE_ID)
# pins this node to the cognitive role and strips any other advertised role.
DUAL_LINEAGE_NODE_ID=oracle-heavy
DUAL_LINEAGE_NODE_ROLE=cognitive
# llama.cpp on this VM. If it runs on another host, use that host's private address; the
# node reports degraded while the backend does not answer /v1/models.
DUAL_LINEAGE_NODE_BACKEND_URL=http://127.0.0.1:8081
# Advertised model id. Requests that name a model match only this id, so it must equal the
# default cognitive model (models/weight-inventory.json). goblin-core is a service name.
DUAL_LINEAGE_NODE_COGNITIVE_MODEL=neohorse-4b
# Empty sends the advertised id to the backend. Set only if llama-server uses another alias.
DUAL_LINEAGE_NODE_COGNITIVE_BACKEND_MODEL=
DUAL_LINEAGE_NODE_BACKEND_NAME=llama.cpp
DUAL_LINEAGE_NODE_GPU=OCI-CPU
DUAL_LINEAGE_NODE_MAX_CONCURRENCY=1
DUAL_LINEAGE_NODE_AGENT_HOST=127.0.0.1
DUAL_LINEAGE_NODE_AGENT_PORT=8112
DUAL_LINEAGE_NODE_PUBLIC_ENDPOINT=https://oracle-129.213.50.249.nip.io
# Optional local-only operational-learning proxy. The bootstrap writes the secret on Oracle.
DUAL_LINEAGE_NODE_SHADOW_WORKER_URL=
DUAL_LINEAGE_NODE_SHADOW_WORKER_SECRET=
DUAL_LINEAGE_CONTROL_PLANE_URL=https://goblin-dual-lineage-api.onrender.com
# Required; never commit real values.
DUAL_LINEAGE_NODE_REGISTRATION_SECRET=
DUAL_LINEAGE_NODE_INFERENCE_SECRET=
# Required for /admin/drain and /admin/undrain (the kill switch). Never commit real values.
DUAL_LINEAGE_NODE_ADMIN_SECRET=
