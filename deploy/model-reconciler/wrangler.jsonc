{
  // Model reconciler. Deploy with `npx wrangler@4 deploy` from this directory.
  // Secret (CORE_API_KEY) is set with `wrangler secret put` and never committed.
  "name": "ayahos-model-reconciler",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "vars": {
    "CORE_API_URL": "https://api.ayahos.app"
  },
  "triggers": { "crons": ["*/5 * * * *"] }
}