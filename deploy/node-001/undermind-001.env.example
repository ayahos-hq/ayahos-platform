# Copy beside the node agent on Node 1 (the local desktop) and set values
# out-of-band. Never commit real values.
#
# This is a SECOND node-agent instance on the same desktop as node-001.
# It is required, not optional splitting: compute/config.py pins
# node-001 (Mind 1) to the cognitive role only, and the Compute Registry
# strips any other role from its heartbeats. The Liquid LFM critic is an
# autonomic (Undermind) workload, so it registers under its own identity,
# undermind-001, which is pinned to autonomic only.
DUAL_LINEAGE_NODE_ID=undermind-001
DUAL_LINEAGE_NODE_ROLE=autonomic
# Standalone llama-server for the LFM (see start-undermind.ps1). Kept
# separate from the cognitive llama-swap instance so a model swap on the
# cognitive side can never cold-start the critic.
DUAL_LINEAGE_NODE_BACKEND_URL=http://127.0.0.1:8082
DUAL_LINEAGE_NODE_AUTONOMIC_MODEL=lfm2.5-1.2b
DUAL_LINEAGE_NODE_AUTONOMIC_BACKEND_MODEL=lfm2.5-1.2b
DUAL_LINEAGE_NODE_BACKEND_NAME=llama.cpp-lfm2.5
DUAL_LINEAGE_NODE_GPU=NVIDIA GeForce RTX 3060 12GB
DUAL_LINEAGE_NODE_MAX_CONCURRENCY=1
DUAL_LINEAGE_NODE_AGENT_HOST=127.0.0.1
DUAL_LINEAGE_NODE_AGENT_PORT=8111
DUAL_LINEAGE_NODE_PUBLIC_ENDPOINT=https://undermind-001.example.invalid:8111
DUAL_LINEAGE_CONTROL_PLANE_URL=https://goblin-dual-lineage-api.onrender.com
# Required; never commit real values.
DUAL_LINEAGE_NODE_REGISTRATION_SECRET=
DUAL_LINEAGE_NODE_INFERENCE_SECRET=
DUAL_LINEAGE_NODE_ADMIN_SECRET=
DUAL_LINEAGE_NODE_BACKEND_API_KEY=
