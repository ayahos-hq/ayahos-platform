# Copy to %USERPROFILE%\.goblin\node001\node.env and set secrets out-of-band.
# Never commit real values.
#
# Node 1 (Mind 1) is the operator desktop GPU. Fly Control Hub only routes.
# Public HTTPS is the Oracle Caddy vhost that relays to local 127.0.0.1:8110
# (remote listen 127.0.0.1:18110, not 18111).
DUAL_LINEAGE_NODE_ID=node-001
DUAL_LINEAGE_NODE_ROLE=cognitive
DUAL_LINEAGE_NODE_BACKEND_URL=http://127.0.0.1:8080
# Advertised id must match public chat / Core (still goblin-core until HQ cutover).
DUAL_LINEAGE_NODE_COGNITIVE_MODEL=goblin-core
# llama-swap model id on the desktop.
DUAL_LINEAGE_NODE_COGNITIVE_BACKEND_MODEL=qwen35-9b-raw
# Extra ids advertised on the heartbeat so Core can pin a native llama-swap model.
DUAL_LINEAGE_NODE_COGNITIVE_MODELS=qwen35-9b-raw,qwen35-4b-raw,neohorse-4b
DUAL_LINEAGE_NODE_BACKEND_NAME=llama-swap/llama.cpp-vulkan
DUAL_LINEAGE_NODE_GPU=NVIDIA GeForce RTX 3060 12GB
DUAL_LINEAGE_NODE_MAX_CONCURRENCY=1
DUAL_LINEAGE_NODE_HEARTBEAT_INTERVAL=20
DUAL_LINEAGE_NODE_AGENT_HOST=127.0.0.1
DUAL_LINEAGE_NODE_AGENT_PORT=8110
DUAL_LINEAGE_NODE_PUBLIC_ENDPOINT=https://129.213.50.249.nip.io
DUAL_LINEAGE_CONTROL_PLANE_URL=https://ayahos-control-api.fly.dev
# Required; must match Fly. Never commit real values.
DUAL_LINEAGE_NODE_REGISTRATION_SECRET=
DUAL_LINEAGE_NODE_INFERENCE_SECRET=
DUAL_LINEAGE_NODE_ADMIN_SECRET=
