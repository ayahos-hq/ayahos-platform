# Copy to /etc/ayahos/aliyun-heavy.env and set values out-of-band.
# Alibaba ECS is a cognitive-only heavy peer. Fly Control Hub remains
# ayahos-control-api.fly.dev; this node never hosts policy.
DUAL_LINEAGE_NODE_ID=aliyun-heavy
DUAL_LINEAGE_NODE_ROLE=cognitive
# llama.cpp on this VM.
DUAL_LINEAGE_NODE_BACKEND_URL=http://127.0.0.1:8081
# Advertised model id. Public chat matches this when the request has no pin.
# Production Fly still expects goblin-core until the HQ identity cutover ships.
DUAL_LINEAGE_NODE_COGNITIVE_MODEL=goblin-core
# Free-tier CPU: keep the GGUF tiny. 7B needs a GPU that is not free.
DUAL_LINEAGE_NODE_COGNITIVE_BACKEND_MODEL=qwen2.5-0.5b-instruct
DUAL_LINEAGE_NODE_BACKEND_NAME=llama.cpp
DUAL_LINEAGE_NODE_GPU=Alibaba-t5-1c1g
DUAL_LINEAGE_NODE_MAX_CONCURRENCY=1
DUAL_LINEAGE_NODE_AGENT_HOST=127.0.0.1
DUAL_LINEAGE_NODE_AGENT_PORT=8112
DUAL_LINEAGE_NODE_PUBLIC_ENDPOINT=https://aliyun-heavy.example.invalid
DUAL_LINEAGE_CONTROL_PLANE_URL=https://ayahos-control-api.fly.dev
# Required; never commit real values. Must match Fly Control Hub.
DUAL_LINEAGE_NODE_REGISTRATION_SECRET=
DUAL_LINEAGE_NODE_INFERENCE_SECRET=
DUAL_LINEAGE_NODE_ADMIN_SECRET=
