{
  "title": "AyahOS — Runtime and feedback loop",
  "description": "ayahos-managed:observability-v1\nManaged by deploy/datadog/ayahos-dashboard.json. Production API telemetry and bounded human feedback. No-data is unverified; consult /control and the Shared Spine for retained evidence. Latency metrics are sampled gauges, not percentile distributions.",
  "layout_type": "ordered",
  "widgets": [
    {
      "definition": {
        "type": "note",
        "content": "AyahOS production • Overmind proposes, Undermind governs, Shared Spine records.\nFeedback: terminal response → bounded human rating → Shared Spine → /control review → Datadog counter. Readiness is advisory; no automatic training or promotion. No data does not mean healthy. Latency shows sampled gauge values, not p95. Evidence readiness updates when the API readiness endpoint is queried.",
        "background_color": "gray",
        "font_size": "14",
        "text_align": "left"
      },
      "layout": {"x": 0, "y": 0, "width": 12, "height": 2}
    },
    {
      "definition": {
        "type": "timeseries", "title": "Cognition requests by terminal status",
        "requests": [{"q": "sum:goblin.dual_lineage.cognition.requests{env:production,service:goblin-dual-lineage-api} by {status}.as_count()", "display_type": "bars"}]
      },
      "layout": {"x": 0, "y": 2, "width": 6, "height": 3}
    },
    {
      "definition": {
        "type": "timeseries", "title": "Cognition latency — maximum sampled ms",
        "requests": [{"q": "max:goblin.dual_lineage.cognition.latency_ms{env:production,service:goblin-dual-lineage-api}", "display_type": "line"}]
      },
      "layout": {"x": 6, "y": 2, "width": 6, "height": 3}
    },
    {
      "definition": {
        "type": "timeseries", "title": "Runtime incidents by status",
        "requests": [{"q": "sum:goblin.dual_lineage.cognition.incidents{env:production,service:goblin-dual-lineage-api} by {status}.as_count()", "display_type": "bars"}]
      },
      "layout": {"x": 0, "y": 5, "width": 6, "height": 3}
    },
    {
      "definition": {
        "type": "timeseries", "title": "Interrupts by reason",
        "requests": [{"q": "sum:goblin.dual_lineage.cognition.interrupts{env:production,service:goblin-dual-lineage-api} by {interrupt}.as_count()", "display_type": "bars"}]
      },
      "layout": {"x": 6, "y": 5, "width": 6, "height": 3}
    },
    {
      "definition": {
        "type": "timeseries", "title": "Human feedback responses by rating",
        "requests": [{"q": "sum:goblin.dual_lineage.feedback.responses{env:production,service:goblin-dual-lineage-api} by {rating}.as_count()", "display_type": "bars"}]
      },
      "layout": {"x": 0, "y": 8, "width": 6, "height": 3}
    },
    {
      "definition": {
        "type": "timeseries", "title": "Provider latency — maximum sampled ms",
        "requests": [{"q": "max:goblin.dual_lineage.providers.total_latency_ms{env:production,service:goblin-dual-lineage-api} by {provider}", "display_type": "line"}]
      },
      "layout": {"x": 6, "y": 8, "width": 6, "height": 3}
    },
    {
      "definition": {
        "type": "timeseries", "title": "Provider errors and timeouts",
        "requests": [
          {"q": "sum:goblin.dual_lineage.providers.errors{env:production,service:goblin-dual-lineage-api} by {provider}.as_count()", "display_type": "bars"},
          {"q": "sum:goblin.dual_lineage.providers.timeouts{env:production,service:goblin-dual-lineage-api} by {provider}.as_count()", "display_type": "line"}
        ]
      },
      "layout": {"x": 0, "y": 11, "width": 6, "height": 3}
    },
    {
      "definition": {
        "type": "timeseries", "title": "Learning evidence readiness — 0 or 1, advisory",
        "requests": [
          {"q": "avg:goblin.dual_lineage.evidence.ready_training{env:production,service:goblin-dual-lineage-api}", "display_type": "line"},
          {"q": "avg:goblin.dual_lineage.evidence.ready_promotion{env:production,service:goblin-dual-lineage-api}", "display_type": "line"}
        ]
      },
      "layout": {"x": 6, "y": 11, "width": 6, "height": 3}
    }
  ]
}
