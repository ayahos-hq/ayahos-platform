# syntax=docker/dockerfile:1
# The Octopus image-build step must supply an immutable PYTHON_BASE_IMAGE@sha256:...
ARG PYTHON_BASE_IMAGE
FROM ${PYTHON_BASE_IMAGE}

ARG CORE_SHA
ARG WORKLOADS_SHA
ARG PLATFORM_SHA
ARG RELEASE_MANIFEST_SHA256

LABEL org.opencontainers.image.title="AyahOS Core + Ruby Workloads"
LABEL org.opencontainers.image.description="Candidate composite runtime; Python remains authoritative"
LABEL org.opencontainers.image.revision="${PLATFORM_SHA}"
LABEL com.ayahos.source.ayahos-core="${CORE_SHA}"
LABEL com.ayahos.source.ayahos-workloads="${WORKLOADS_SHA}"
LABEL com.ayahos.source.ayahos-platform="${PLATFORM_SHA}"
LABEL com.ayahos.release-manifest-sha256="${RELEASE_MANIFEST_SHA256}"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    BUNDLE_WITHOUT="development:test"

RUN test -n "${CORE_SHA}" \
    && test -n "${WORKLOADS_SHA}" \
    && test -n "${PLATFORM_SHA}" \
    && test -n "${RELEASE_MANIFEST_SHA256}"

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
       build-essential \
       libpq-dev \
       libsqlite3-dev \
       pkg-config \
       ruby-full \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY apps/api /app/apps/api
COPY apps/rag-ruby /app/apps/rag-ruby
COPY apps/control-ruby /app/apps/control-ruby
COPY apps/ruby_worker /app/apps/ruby_worker
COPY scripts/start-hq-composite.sh /app/scripts/start-hq-composite.sh
COPY COMPOSITE-SOURCE-MANIFEST.json /app/COMPOSITE-SOURCE-MANIFEST.json

RUN python -m pip install --no-cache-dir -e './apps/api[control]'

ENV BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_JOBS=1 \
    BUNDLE_RETRY=2

RUN cd /app/apps/rag-ruby && bundle install --no-cache \
    && cd /app/apps/control-ruby && bundle install --no-cache \
    && cd /app/apps/ruby_worker && bundle install --no-cache

RUN chmod 0755 /app/scripts/start-hq-composite.sh \
    && test -s /app/COMPOSITE-SOURCE-MANIFEST.json \
    && python -c 'from dual_lineage.main import app; assert app is not None'

EXPOSE 8000

ENTRYPOINT ["/app/scripts/start-hq-composite.sh"]
